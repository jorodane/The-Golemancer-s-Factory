<Project>
  <PropertyGroup>
    <FrozenSdkFramework>$(TargetFramework)</FrozenSdkFramework>
    <FrozenSdkFramework Condition="'$(TargetFramework)' == 'net10.0-android' Or '$(TargetFramework)' == 'net10.0-ios'">net10.0</FrozenSdkFramework>
    <FrozenSdkCopyLocal Condition="'$(FrozenSdkCopyLocal)' == ''">true</FrozenSdkCopyLocal>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PackEngine.Contracts">
      <HintPath>$(GolemancerGameRoot)SDK/$(FrozenSdkFramework)/PackEngine.Contracts.dll</HintPath>
      <Private>$(FrozenSdkCopyLocal)</Private>
    </Reference>
    <Reference Include="PackEngine.Runtime" Condition="'$(UseGameRuntime)' == 'true' Or '$(MSBuildProjectName)' == 'Golemancer.Runtime'">
      <HintPath>$(GolemancerGameRoot)SDK/$(FrozenSdkFramework)/PackEngine.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <ProjectReference Include="$(GolemancerGameRoot)src/Golemancer.Contracts/Golemancer.Contracts.csproj" Condition="'$(MSBuildProjectName)' != 'Golemancer.Contracts'" />
    <ProjectReference Include="$(GolemancerGameRoot)src/Golemancer.Runtime/Golemancer.Runtime.csproj" Condition="'$(UseGameRuntime)' == 'true'" />
  </ItemGroup>
  <Import Project="$(GolemancerGameRoot)SDK/FrozenEngine.targets" />
</Project>
