<Project>
  <ItemGroup>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../Builds/Windows/PackEngine.Contracts.dll"><ExpectedHash>63FC8A6407D2960DD80C0140A981170A8D57E3289326A8DE4B8B8ED45625D4A9</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../Builds/Windows/PackEngine.Runtime.dll"><ExpectedHash>D1D0D0412FEADB3BB090B567B2CC27A6FB7F4C98A2BBEAC3CB3314413951AAB9</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net10.0/PackEngine.Contracts.dll"><ExpectedHash>3B88AF0EFEA8F3ED6D4862053311306C0216C053F6F761A433EF864197388B95</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net10.0/PackEngine.Runtime.dll"><ExpectedHash>88E20F31FD128EB2914C10CB62EB0A995B96267CFE7397D9C5B8668416543D5B</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net48/PackEngine.Contracts.dll"><ExpectedHash>63FC8A6407D2960DD80C0140A981170A8D57E3289326A8DE4B8B8ED45625D4A9</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net48/PackEngine.Runtime.dll"><ExpectedHash>D1D0D0412FEADB3BB090B567B2CC27A6FB7F4C98A2BBEAC3CB3314413951AAB9</ExpectedHash></FrozenEngineFile>
  </ItemGroup>
  <Target Name="CheckFrozenEngine" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('%(FrozenEngineFile.Identity)')" Text="Frozen engine/API file missing: %(FrozenEngineFile.Identity). Restore the complete workspace." />
    <GetFileHash Files="@(FrozenEngineFile)" Algorithm="SHA256" MetadataName="ActualHash"><Output TaskParameter="Items" ItemName="CheckedFrozenEngine" /></GetFileHash>
    <Error Condition="'%(CheckedFrozenEngine.ActualHash)' != '%(CheckedFrozenEngine.ExpectedHash)'" Text="Frozen engine/API changed: %(CheckedFrozenEngine.Identity). Restore the SDK baseline; engine upgrades are a separate operation." />
  </Target>
</Project>
