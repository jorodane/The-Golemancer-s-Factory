<Project>
  <ItemGroup>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../Builds/Windows/PackEngine.Contracts.dll"><ExpectedHash>933E2BE581F01EFE5B2E7E02852147F78F602B325C6122EDD9A00273FD31EDEE</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../Builds/Windows/PackEngine.Runtime.dll"><ExpectedHash>40F29656782BFBD3A9780DA16CAD78A03628FD2AC624EAF511329FAF2F3335CA</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net10.0/PackEngine.Contracts.dll"><ExpectedHash>6F630440FEA10EEBE65A13F5B3F2072ECF4F6012F0967BC4DA76A6DC6ACF681C</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net10.0/PackEngine.Runtime.dll"><ExpectedHash>92B27207405BB55D9BFE844D69B9F39AB447A6D3759AB25F0C273CF251BD21AC</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net48/PackEngine.Contracts.dll"><ExpectedHash>933E2BE581F01EFE5B2E7E02852147F78F602B325C6122EDD9A00273FD31EDEE</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net48/PackEngine.Runtime.dll"><ExpectedHash>40F29656782BFBD3A9780DA16CAD78A03628FD2AC624EAF511329FAF2F3335CA</ExpectedHash></FrozenEngineFile>
  </ItemGroup>
  <Target Name="CheckFrozenEngine" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('%(FrozenEngineFile.Identity)')" Text="Frozen engine/API file missing: %(FrozenEngineFile.Identity). Restore the complete workspace." />
    <GetFileHash Files="@(FrozenEngineFile)" Algorithm="SHA256" MetadataName="ActualHash"><Output TaskParameter="Items" ItemName="CheckedFrozenEngine" /></GetFileHash>
    <Error Condition="'%(CheckedFrozenEngine.ActualHash)' != '%(CheckedFrozenEngine.ExpectedHash)'" Text="Frozen engine/API changed: %(CheckedFrozenEngine.Identity). Restore the SDK baseline; engine upgrades are a separate operation." />
  </Target>
</Project>
