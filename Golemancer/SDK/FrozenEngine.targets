<Project>
  <ItemGroup>
    <FrozenEngineFile Include="$(GolemancerGameRoot)SDK/net10.0/Golemancer.Contracts.dll"><ExpectedHash>15308DABF713F0A68A08EB5102A44C8DD7A4969A80BF4A59D295CB171F7C4004</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(GolemancerGameRoot)SDK/net10.0/Golemancer.Engine.dll"><ExpectedHash>CB29197AF572B7E9E87258C14F347BB9E65C424C0C490D26913E01D7A5F57088</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(GolemancerGameRoot)SDK/net48/Golemancer.Contracts.dll"><ExpectedHash>EA2E02C0137B8EAEEA5C461A3F444FA477C0EA1BA5143835E81D429714D98681</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(GolemancerGameRoot)SDK/net48/Golemancer.Engine.dll"><ExpectedHash>B9055C0938D615406DDC125DC08B139B55853BB8FDB03647A8029A0D35EDB59F</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(GolemancerGameRoot)Builds/Windows/Golemancer.Engine.dll"><ExpectedHash>B9055C0938D615406DDC125DC08B139B55853BB8FDB03647A8029A0D35EDB59F</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(GolemancerGameRoot)Builds/Windows/Golemancer.Contracts.dll"><ExpectedHash>EA2E02C0137B8EAEEA5C461A3F444FA477C0EA1BA5143835E81D429714D98681</ExpectedHash></FrozenEngineFile>
  </ItemGroup>
  <Target Name="CheckFrozenEngine" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('%(FrozenEngineFile.Identity)')" Text="Frozen engine/API file missing: %(FrozenEngineFile.Identity). Restore the complete Golemancer folder." />
    <GetFileHash Files="@(FrozenEngineFile)" Algorithm="SHA256" MetadataName="ActualHash"><Output TaskParameter="Items" ItemName="CheckedFrozenEngine" /></GetFileHash>
    <Error Condition="'%(CheckedFrozenEngine.ActualHash)' != '%(CheckedFrozenEngine.ExpectedHash)'" Text="Frozen engine/API changed: %(CheckedFrozenEngine.Identity). This experiment must use the original SDK and engine binaries." />
  </Target>
</Project>
