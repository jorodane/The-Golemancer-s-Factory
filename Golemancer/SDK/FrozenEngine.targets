<Project>
  <ItemGroup>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../Builds/Windows/PackEngine.Contracts.dll"><ExpectedHash>9658EA921D4EBA6B73E64DF2BAC239588C578B9FB5809900A35847A882A9B1FA</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../Builds/Windows/PackEngine.Runtime.dll"><ExpectedHash>E21E55120A9D2C2BD3620790923A511E54BC49C8968279EF2B89A58EDABB6726</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net10.0/PackEngine.Contracts.dll"><ExpectedHash>83F1B878695574E1C97548D1C50950E410E1A8EA38B809A32A99C389D5D103BA</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net10.0/PackEngine.Runtime.dll"><ExpectedHash>C579F6B8D0900F42BD03FAE43133CE490E34C7A47D588595EF3A5F3FA7C8A027</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net48/PackEngine.Contracts.dll"><ExpectedHash>9658EA921D4EBA6B73E64DF2BAC239588C578B9FB5809900A35847A882A9B1FA</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net48/PackEngine.Runtime.dll"><ExpectedHash>E21E55120A9D2C2BD3620790923A511E54BC49C8968279EF2B89A58EDABB6726</ExpectedHash></FrozenEngineFile>
  </ItemGroup>
  <Target Name="CheckFrozenEngine" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('%(FrozenEngineFile.Identity)')" Text="Frozen engine/API file missing: %(FrozenEngineFile.Identity). Restore the complete workspace." />
    <GetFileHash Files="@(FrozenEngineFile)" Algorithm="SHA256" MetadataName="ActualHash"><Output TaskParameter="Items" ItemName="CheckedFrozenEngine" /></GetFileHash>
    <Error Condition="'%(CheckedFrozenEngine.ActualHash)' != '%(CheckedFrozenEngine.ExpectedHash)'" Text="Frozen engine/API changed: %(CheckedFrozenEngine.Identity). Restore the SDK baseline; engine upgrades are a separate operation." />
  </Target>
</Project>
