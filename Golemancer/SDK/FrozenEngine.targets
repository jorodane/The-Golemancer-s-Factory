<Project>
  <ItemGroup>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../Builds/Windows/PackEngine.Contracts.dll"><ExpectedHash>18D1F116821D3A9404C1513F17090361C10F6EDE26EB9872E80D564793744ADE</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../Builds/Windows/PackEngine.Runtime.dll"><ExpectedHash>4BDA6047511C405EAE11D82EAA23123CD26CE36F62D4A96C7F87B4EB38750139</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net10.0/PackEngine.Contracts.dll"><ExpectedHash>F87919033D20BF9E22BCBEAC052AF44610E1FE759F167BFAFB84323A342EEACB</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net10.0/PackEngine.Runtime.dll"><ExpectedHash>D3C252158B877624EADF545D467970857D74C2381669085E2B1416EA5EBAEB66</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net48/PackEngine.Contracts.dll"><ExpectedHash>18D1F116821D3A9404C1513F17090361C10F6EDE26EB9872E80D564793744ADE</ExpectedHash></FrozenEngineFile>
    <FrozenEngineFile Include="$(MSBuildThisFileDirectory)../SDK/net48/PackEngine.Runtime.dll"><ExpectedHash>4BDA6047511C405EAE11D82EAA23123CD26CE36F62D4A96C7F87B4EB38750139</ExpectedHash></FrozenEngineFile>
  </ItemGroup>
  <Target Name="CheckFrozenEngine" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('%(FrozenEngineFile.Identity)')" Text="Frozen engine/API file missing: %(FrozenEngineFile.Identity). Restore the complete workspace." />
    <GetFileHash Files="@(FrozenEngineFile)" Algorithm="SHA256" MetadataName="ActualHash"><Output TaskParameter="Items" ItemName="CheckedFrozenEngine" /></GetFileHash>
    <Error Condition="'%(CheckedFrozenEngine.ActualHash)' != '%(CheckedFrozenEngine.ExpectedHash)'" Text="Frozen engine/API changed: %(CheckedFrozenEngine.Identity). Restore the SDK baseline; engine upgrades are a separate operation." />
  </Target>
</Project>
