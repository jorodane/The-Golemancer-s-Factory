<Project DefaultTargets="Publish">
  <PropertyGroup>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))/</RepositoryRoot>
    <GolemancerGameRoot>$(RepositoryRoot)</GolemancerGameRoot>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <PublishDirectory>$(RepositoryRoot)Builds/Windows/</PublishDirectory>
    <HostDirectory>$(RepositoryRoot)src/Golemancer.Host/bin/$(Configuration)/net48/</HostDirectory>
    <VerificationDirectory>$(RepositoryRoot)tests/Golemancer.Verification/bin/$(Configuration)/net48/</VerificationDirectory>
    <SourceRevision Condition="'$(SourceRevision)' == ''">unknown</SourceRevision>
  </PropertyGroup>
  <Import Project="$(RepositoryRoot)SDK/FrozenEngine.targets" />
  <Target Name="Publish" DependsOnTargets="CheckFrozenEngine">
    <Error Condition="!Exists('$(HostDirectory)Golemancer.exe')" Text="Build the net48 solution first." />
    <Error Condition="!Exists('$(VerificationDirectory)Golemancer.Verification.exe')" Text="The net48 verification build is missing." />
    <ItemGroup>
      <HostRuntime Include="$(HostDirectory)*.exe;$(HostDirectory)*.dll;$(HostDirectory)*.config" />
      <HostRuntime Remove="$(HostDirectory)PackEngine.Runtime.dll;$(HostDirectory)PackEngine.Contracts.dll" />
      <VerificationRuntime Include="$(VerificationDirectory)Golemancer.Verification.exe;$(VerificationDirectory)Golemancer.Verification.exe.config" />
      <ModuleRuntime Include="$(RepositoryRoot)Content/Packs/**/Bin/net48/*.dll" />
    </ItemGroup>
    <Error Condition="'@(ModuleRuntime)' == ''" Text="The net48 object-pack DLLs are missing." />
    <MakeDir Directories="$(PublishDirectory)" />
    <Copy SourceFiles="@(HostRuntime);@(VerificationRuntime)" DestinationFolder="$(PublishDirectory)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <PublishedRuntime Include="$(PublishDirectory)*.exe;$(PublishDirectory)*.dll;$(PublishDirectory)*.config;@(ModuleRuntime)" />
      <PublishedRuntime Update="@(PublishedRuntime)">
        <RelativePath>$([MSBuild]::MakeRelative('$(RepositoryRoot)', '%(PublishedRuntime.FullPath)'))</RelativePath>
      </PublishedRuntime>
    </ItemGroup>
    <GetFileHash Files="@(PublishedRuntime)" Algorithm="SHA256" MetadataName="Sha256">
      <Output TaskParameter="Items" ItemName="HashedRuntime" />
    </GetFileHash>
    <WriteLinesToFile File="$(PublishDirectory)SHA256SUMS" Lines="@(HashedRuntime->'%(Sha256)  %(RelativePath)')" Overwrite="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(PublishDirectory)build-info.json" Lines="{ &quot;sourceCommit&quot;: &quot;$(SourceRevision)&quot;, &quot;target&quot;: &quot;net48&quot;, &quot;ui&quot;: &quot;WPF&quot;, &quot;contentRoot&quot;: &quot;../../Content&quot;, &quot;windowsGuiTested&quot;: false }" Overwrite="true" Encoding="UTF-8" />
    <Message Importance="high" Text="Published Windows executables to Builds/Windows. Module DLLs and XML stay in repository Content/Packs. Images and saves are untouched." />
  </Target>
</Project>
