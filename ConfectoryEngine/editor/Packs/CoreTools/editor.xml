<EditorExtensions version="1">
  <Shell id="editor.core.layout" sidebarWidth="250" contextWidth="300" logHeight="150" startupMotion="logo:140:480:10;brand-title:270:460:6;brand-subtitle:430:360:0;connect:630:360:0;later:740:310:0" homeDuration="650" autoHomeDelay="820" />
  <Command id="editor.core.notice" handler="editor.core.effect" payload="None"><Argument name="kind" value="message" /><Argument name="value" value="이 버튼과 화면은 에디터 객체팩에서 실행 중이야." /></Command>
  <Command id="editor.core.refresh" extends="editor.core.notice"><Argument name="kind" value="refresh" /><Argument name="value" value="" /></Command>
  <Command id="editor.core.documents" extends="editor.core.notice"><Argument name="kind" value="tab" /><Argument name="value" value="documents" /></Command>
  <Command id="editor.core.focus" extends="editor.core.notice"><Argument name="kind" value="layout" /><Argument name="value" value="focus" /></Command>
  <Command id="editor.core.restore" extends="editor.core.focus"><Argument name="value" value="normal" /></Command>
  <Panel id="editor.core.tools" title="프로젝트 작업 공간" view="editor.core.workspace" slot="workspace.main" order="0" />
  <Window id="editor.core.elements" title="요소 탐색기" view="editor.core.elements" />
  <Window id="editor.core.inspector" title="요소 편집기" view="editor.core.inspector" />
  <Command id="editor.core.elements.open" handler="editor.core.elements.open" payload="Text">
    <Argument name="mode" value="browse" /><Argument name="window" value="editor.core.elements" /><Argument name="baseView" value="editor.core.elements" />
    <Argument name="actionCommand" value="editor.core.elements.action" /><Argument name="inputCommand" value="editor.core.elements.input" />
  </Command>
  <Command id="editor.core.inspector.open" extends="editor.core.elements.open">
    <Argument name="mode" value="inspect" /><Argument name="window" value="editor.core.inspector" /><Argument name="baseView" value="editor.core.inspector" />
  </Command>
  <Command id="editor.core.elements.action" handler="editor.core.elements.action" payload="None" />
  <Command id="editor.core.elements.input" handler="editor.core.elements.input" payload="Text" />
  <Command id="editor.core.workspace.open" extends="editor.core.elements.open">
    <Argument name="mode" value="workspace" /><Argument name="window" value="panel.workspace.main" /><Argument name="baseView" value="editor.core.workspace" />
  </Command>
  <Navigation id="editor.core.home" title="작업 공간" surface="menu" command="editor.core.workspace.open" />
  <Navigation id="editor.core.browse" title="요소 탐색기" surface="menu" command="editor.core.elements.open" />
  <Navigation id="editor.core.browse.hotbar" extends="editor.core.browse" surface="hotbar" />
  <ObjectEditor id="editor.core.element.form" kind="*" title="작업 공간에서 편집" window="panel.workspace.main" command="editor.core.workspace.open" priority="-100" />
</EditorExtensions>
