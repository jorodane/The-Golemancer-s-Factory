<Project DefaultTargets="Publish">
  <PropertyGroup>
    <EditorPublishDir>$(MSBuildThisFileDirectory)Builds/Windows/</EditorPublishDir>
    <Revision Condition="'$(Revision)' == ''">unknown</Revision>
  </PropertyGroup>
  <Target Name="Publish">
    <ItemGroup>
      <Runtime Include="$(MSBuildThisFileDirectory)Confectory.Editor/bin/Release/net48/*.exe;$(MSBuildThisFileDirectory)Confectory.Editor/bin/Release/net48/*.dll;$(MSBuildThisFileDirectory)Confectory.Editor/bin/Release/net48/*.config" Exclude="$(MSBuildThisFileDirectory)Confectory.Editor/bin/Release/net48/Microsoft.Web.WebView2.*" />
      <Runtime Include="$(MSBuildThisFileDirectory)Confectory.Tool/bin/Release/net48/Confectory.Tool.exe;$(MSBuildThisFileDirectory)Confectory.Tool/bin/Release/net48/Confectory.Tool.exe.config" />
      <Runtime Include="$(MSBuildThisFileDirectory)Confectory.PackHost/bin/Release/net48/Confectory.PackHost.exe;$(MSBuildThisFileDirectory)Confectory.PackHost/bin/Release/net48/Confectory.PackHost.exe.config" />
    </ItemGroup>
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)Confectory.Editor/bin/Release/net48/Confectory.Editor.exe')" Text="Build editor/Editor.slnx first." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)Confectory.Tool/bin/Release/net48/Confectory.Tool.exe')" Text="Build the net48 CLI first." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)Confectory.PackHost/bin/Release/net48/Confectory.PackHost.exe')" Text="Build the editor pack host first." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)Packs/CoreTools/Bin/net48/Confectory.Editor.CoreTools.dll')" Text="Build the core editor pack first." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)examples/MobileLab/Bin/net48/Confectory.Editor.MobileLab.dll')" Text="Build the shared editor pack example first." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)Confectory.Launcher/bin/Release/net48/StartEditor.exe')" Text="Build the launcher first." />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Confectory.Launcher/bin/Release/net48/StartEditor.exe;$(MSBuildThisFileDirectory)Confectory.Launcher/bin/Release/net48/StartEditor.exe.config" DestinationFolder="$(MSBuildThisFileDirectory)../" />
    <MakeDir Directories="$(EditorPublishDir)" />
    <ItemGroup>
      <RetiredBridge Include="$(EditorPublishDir)Confectory.Mcp.exe;$(EditorPublishDir)Confectory.Mcp.exe.config;$(EditorPublishDir)Microsoft.Web.WebView2.*;$(EditorPublishDir)runtimes/**/WebView2Loader.dll;$(EditorPublishDir)Licenses/WebView2-LICENSE.txt" />
    </ItemGroup>
    <Delete Files="@(RetiredBridge)" />
    <Copy SourceFiles="@(Runtime)" DestinationFolder="$(EditorPublishDir)" SkipUnchangedFiles="true" />
    <Exec Command="&quot;$(EditorPublishDir)Confectory.Tool.exe&quot; bundle-engine --recipe &quot;$(MSBuildThisFileDirectory)engine.xml&quot; --output &quot;$(EditorPublishDir)Engine&quot;" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ThirdParty/Roslyn-LICENSE.txt;$(MSBuildThisFileDirectory)ThirdParty/Roslyn-ThirdPartyNotices.rtf" DestinationFolder="$(EditorPublishDir)Licenses" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(EditorPublishDir)Providers" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Confectory.Assistant.Command/bin/Release/net48/Confectory.Assistant.Command.dll" DestinationFolder="$(EditorPublishDir)Providers" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Confectory.Assistant.Codex/bin/Release/net48/Confectory.Assistant.Codex.dll" DestinationFolder="$(EditorPublishDir)Providers" />
    <ItemGroup>
      <Published Include="$(EditorPublishDir)Licenses/*.txt;$(EditorPublishDir)Licenses/*.rtf" />
      <Published Include="$(EditorPublishDir)Engine/**/*" />
      <Published Include="$(EditorPublishDir)*.exe;$(EditorPublishDir)*.dll;$(EditorPublishDir)*.config;$(EditorPublishDir)Providers/*.dll;$(MSBuildThisFileDirectory)Packs/CoreTools/Bin/net48/*.dll;$(MSBuildThisFileDirectory)Packs/CoreTools/*.xml;$(MSBuildThisFileDirectory)../StartEditor.exe;$(MSBuildThisFileDirectory)../StartEditor.exe.config" />
      <Published Include="$(MSBuildThisFileDirectory)examples/MobileLab/Bin/net48/*.dll;$(MSBuildThisFileDirectory)examples/MobileLab/*.xml" />
      <Published Update="@(Published)">
        <RelativePath>$([MSBuild]::MakeRelative('$(EditorPublishDir)', '%(Published.FullPath)'))</RelativePath>
      </Published>
    </ItemGroup>
    <GetFileHash Files="@(Published)" Algorithm="SHA256" MetadataName="Sha256"><Output TaskParameter="Items" ItemName="Hashed" /></GetFileHash>
    <WriteLinesToFile File="$(EditorPublishDir)SHA256SUMS" Lines="@(Hashed->'%(Sha256)  %(RelativePath)')" Overwrite="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(EditorPublishDir)build-info.json" Lines="{ &quot;sourceCommit&quot;: &quot;$(Revision)&quot;, &quot;target&quot;: &quot;net48&quot;, &quot;ui&quot;: &quot;WPF editor shell&quot;, &quot;launcher&quot;: &quot;StartEditor.exe&quot;, &quot;windowsGuiTested&quot;: false }" Overwrite="true" Encoding="UTF-8" />
  </Target>
</Project>
