<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><EnableDynamicLoading>true</EnableDynamicLoading></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Golemancer.Contracts/Golemancer.Contracts.csproj"><Private>false</Private><ExcludeAssets>runtime</ExcludeAssets></ProjectReference>
  </ItemGroup>
  <Target Name="StageExample" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)/Pack/Bin" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(AssemblyName).deps.json" DestinationFolder="$(MSBuildProjectDirectory)/Pack/Bin" />
  </Target>
</Project>
