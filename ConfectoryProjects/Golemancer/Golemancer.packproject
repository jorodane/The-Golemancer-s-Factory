<?xml version='1.0' encoding='utf-8'?>
<EngineProject version="1" id="golemancer" name="The Golemancer’s Factory" packs="Content/Packs" schema="editor-schema.xml" defaultTarget="windows" engineSdk="true">
  <Contract path="docs/CONTRACTS.md" />
  <Contract path="docs/UI_CONTRACTS.md" />
  <EnginePack id="engine.ui.button" directory="Content/Packs/01.EngineButton" />
  <Pack id="foundation">
    <Source project="modules/Golemancer.Conditions/Golemancer.Conditions.csproj" />
    <Source project="modules/Golemancer.Failures/Golemancer.Failures.csproj" />
    <Source project="modules/Golemancer.Logistics/Golemancer.Logistics.csproj" />
  </Pack>
  <Pack id="engine.ui.button" editable="false">
    </Pack>
  <Pack id="golemancer.controls">
    </Pack>
  <Pack id="terrain_rules">
    <Source project="modules/Golemancer.Terrain/Golemancer.Terrain.csproj" />
  </Pack>
  <Pack id="feast_trail_tiles" />
  <Pack id="feast_trail_art" />
  <Pack id="feast_trail_animations" />
  <Pack id="harvesting">
    <Source project="modules/Golemancer.Harvesting/Golemancer.Harvesting.csproj" />
  </Pack>
  <Pack id="crafting">
    <Source project="modules/Golemancer.Crafting/Golemancer.Crafting.csproj" />
  </Pack>
  <Pack id="construction">
    <Source project="modules/Golemancer.Construction/Golemancer.Construction.csproj" />
  </Pack>
  <Pack id="commerce">
    <Source project="modules/Golemancer.Commerce/Golemancer.Commerce.csproj" />
  </Pack>
  <Pack id="golems">
    <Source project="modules/Golemancer.Golems/Golemancer.Golems.csproj" />
  </Pack>
  <Pack id="automation">
    <Source project="modules/Golemancer.Automation/Golemancer.Automation.csproj" />
  </Pack>
  <Pack id="combat">
    <Source project="modules/Golemancer.Combat/Golemancer.Combat.csproj" />
  </Pack>
  <Pack id="story">
    <Source project="modules/Golemancer.Story/Golemancer.Story.csproj" />
  </Pack>
  <Pack id="feast_trail">
    <Source project="modules/Golemancer.FeastTrail/Golemancer.FeastTrail.csproj" />
  </Pack>
  <Pack id="deguldol_art" />
  <Pack id="dialogue_art" />
  <Target id="windows" platform="windows" framework="net48" frameworkProperty="GolemancerTargetFramework">
    <Build>
      <Exec file="dotnet" directory=".">
        <Arg>build</Arg>
        <Arg>src/Golemancer.Host/Golemancer.Host.csproj</Arg>
        <Arg>-p:GolemancerTargetFramework=net48</Arg>
        <Arg>-c</Arg>
        <Arg>Release</Arg>
        <Arg>-p:UseSharedCompilation=false</Arg>
        <Arg>-m:1</Arg>
        <Arg>--disable-build-servers</Arg>
        <Arg>--nologo</Arg>
        <Arg>-v:minimal</Arg>
      </Exec>
      <Exec file="dotnet" directory=".">
        <Arg>build</Arg>
        <Arg>tests/Golemancer.Verification/Golemancer.Verification.csproj</Arg>
        <Arg>-p:GolemancerTargetFramework=net48</Arg>
        <Arg>-c</Arg>
        <Arg>Release</Arg>
        <Arg>-p:UseSharedCompilation=false</Arg>
        <Arg>-m:1</Arg>
        <Arg>--disable-build-servers</Arg>
        <Arg>--nologo</Arg>
        <Arg>-v:minimal</Arg>
      </Exec>
      <Exec file="dotnet" directory=".">
        <Arg>msbuild</Arg>
        <Arg>{engine}/tools/PublishProject.proj</Arg>
        <Arg>-t:Publish</Arg>
        <Arg>-p:Configuration=Release</Arg>
        <Arg>-p:SourceRevision=editor-project-build</Arg>
        <Arg>-nologo</Arg>
        <Arg>-v:minimal</Arg>
        <Arg>-p:HostDirectory=src/Golemancer.Host/bin/Release/net48</Arg>
        <Arg>-p:VerificationDirectory=tests/Golemancer.Verification/bin/Release/net48</Arg>
        <Arg>-p:VerificationName=Golemancer.Verification</Arg>
      </Exec>
    </Build>
    <Run>
      <Exec file="Builds/Windows/Golemancer.exe" directory="." />
    </Run>
    <Verify>
      <Exec file="Builds/Windows/Golemancer.Verification.exe" directory="." />
    </Verify>
    <Smoke>
      <Exec file="Builds/Windows/Golemancer.exe" directory=".">
        <Arg>--smoke</Arg>
      </Exec>
    </Smoke>
  </Target>
  <Target id="linux" platform="linux" framework="net10.0" frameworkProperty="GolemancerTargetFramework">
    <Build>
      <Exec file="dotnet" directory=".">
        <Arg>publish</Arg>
        <Arg>src/Golemancer.Linux/Golemancer.Linux.csproj</Arg>
        <Arg>-r</Arg>
        <Arg>linux-x64</Arg>
        <Arg>--self-contained</Arg>
        <Arg>true</Arg>
        <Arg>-o</Arg>
        <Arg>Builds/Linux/linux-x64</Arg>
        <Arg>-p:GolemancerTargetFramework=net10.0</Arg>
        <Arg>-c</Arg>
        <Arg>Release</Arg>
        <Arg>-p:UseSharedCompilation=false</Arg>
        <Arg>-m:1</Arg>
        <Arg>--disable-build-servers</Arg>
        <Arg>--nologo</Arg>
        <Arg>-v:minimal</Arg>
      </Exec>
    </Build>
    <Run>
      <Exec file="Builds/Linux/linux-x64/Golemancer.Linux" directory="." />
    </Run>
    <Verify>
      <Exec file="dotnet" directory=".">
        <Arg>build</Arg>
        <Arg>tests/Golemancer.Verification/Golemancer.Verification.csproj</Arg>
        <Arg>-p:GolemancerTargetFramework=net10.0</Arg>
        <Arg>-c</Arg>
        <Arg>Release</Arg>
        <Arg>-p:UseSharedCompilation=false</Arg>
        <Arg>-m:1</Arg>
        <Arg>--disable-build-servers</Arg>
        <Arg>--nologo</Arg>
        <Arg>-v:minimal</Arg>
      </Exec>
      <Exec file="dotnet" directory=".">
        <Arg>tests/Golemancer.Verification/bin/Release/net10.0/Golemancer.Verification.dll</Arg>
      </Exec>
    </Verify>
    <Smoke>
      <Exec file="Builds/Linux/linux-x64/Golemancer.Linux" directory=".">
        <Arg>--smoke</Arg>
        <Arg>--frames</Arg>
        <Arg>30</Arg>
        <Env name="SDL_VIDEODRIVER" value="offscreen" />
      </Exec>
    </Smoke>
  </Target>
  <Target id="portable" platform="portable" framework="net10.0" frameworkProperty="GolemancerTargetFramework">
    <Build>
      <Exec file="dotnet" directory=".">
        <Arg>build</Arg>
        <Arg>tests/Golemancer.Verification/Golemancer.Verification.csproj</Arg>
        <Arg>-p:GolemancerTargetFramework=net10.0</Arg>
        <Arg>-c</Arg>
        <Arg>Release</Arg>
        <Arg>-p:UseSharedCompilation=false</Arg>
        <Arg>-m:1</Arg>
        <Arg>--disable-build-servers</Arg>
        <Arg>--nologo</Arg>
        <Arg>-v:minimal</Arg>
      </Exec>
    </Build>
    <Verify>
      <Exec file="dotnet" directory=".">
        <Arg>build</Arg>
        <Arg>tests/Golemancer.Verification/Golemancer.Verification.csproj</Arg>
        <Arg>-p:GolemancerTargetFramework=net10.0</Arg>
        <Arg>-c</Arg>
        <Arg>Release</Arg>
        <Arg>-p:UseSharedCompilation=false</Arg>
        <Arg>-m:1</Arg>
        <Arg>--disable-build-servers</Arg>
        <Arg>--nologo</Arg>
        <Arg>-v:minimal</Arg>
      </Exec>
      <Exec file="dotnet" directory=".">
        <Arg>tests/Golemancer.Verification/bin/Release/net10.0/Golemancer.Verification.dll</Arg>
      </Exec>
    </Verify>
  </Target>
  <Target id="android" platform="android" framework="net10.0-android" frameworkProperty="GolemancerTargetFramework" androidApplication="com.golemancer.factory">
    <Build>
      <Exec file="dotnet" directory=".">
        <Arg>build</Arg>
        <Arg>src/Golemancer.Android/Golemancer.Android.csproj</Arg>
        <Arg>-p:GolemancerTargetFramework=net10.0</Arg>
        <Arg>-c</Arg>
        <Arg>Release</Arg>
        <Arg>-p:UseSharedCompilation=false</Arg>
        <Arg>-m:1</Arg>
        <Arg>--disable-build-servers</Arg>
        <Arg>--nologo</Arg>
        <Arg>-v:minimal</Arg>
      </Exec>
      <Exec file="dotnet" directory=".">
        <Arg>msbuild</Arg>
        <Arg>{engine}/tools/PublishProjectAndroid.proj</Arg>
        <Arg>-p:PackagePath=src/Golemancer.Android/bin/Release/net10.0-android/com.golemancer.factory-Signed.apk</Arg>
        <Arg>-p:PackageName=Golemancer.apk</Arg>
        <Arg>-nologo</Arg>
        <Arg>-v:minimal</Arg>
      </Exec>
    </Build>
  </Target>
  <Target id="ios-simulator-arm64" platform="ios" framework="net10.0-ios" frameworkProperty="GolemancerTargetFramework">
    <Build>
      <Exec file="dotnet" directory=".">
        <Arg>build</Arg>
        <Arg>src/Golemancer.iOS/Golemancer.iOS.csproj</Arg>
        <Arg>-p:GolemancerTargetFramework=net10.0</Arg>
        <Arg>-p:RuntimeIdentifier=iossimulator-arm64</Arg>
