  <Target id="ios-simulator-x64" platform="ios" framework="net10.0-ios" frameworkProperty="GolemancerTargetFramework">
    <Build>
      <Exec file="dotnet" directory=".">
        <Arg>build</Arg>
        <Arg>src/Golemancer.iOS/Golemancer.iOS.csproj</Arg>
        <Arg>-p:GolemancerTargetFramework=net10.0</Arg>
        <Arg>-p:RuntimeIdentifier=iossimulator-x64</Arg>
        <Arg>-c</Arg>
        <Arg>Release</Arg>
        <Arg>-p:UseSharedCompilation=false</Arg>
        <Arg>-m:1</Arg>
