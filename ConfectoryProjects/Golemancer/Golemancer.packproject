        <Arg>tests/Golemancer.Verification/Golemancer.Verification.csproj</Arg>
        <Arg>-p:GolemancerTargetFramework=net10.0</Arg>
        <Arg>-c</Arg>
        <Arg>Release</Arg>
        <Arg>-p:UseSharedCompilation=false</Arg>
