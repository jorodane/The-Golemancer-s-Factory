  <Target id="ios-device" platform="ios" framework="net10.0-ios" frameworkProperty="GolemancerTargetFramework">
    <Build>
      <Exec file="dotnet" directory=".">
        <Arg>publish</Arg>
        <Arg>src/Golemancer.iOS/Golemancer.iOS.csproj</Arg>
        <Arg>-p:GolemancerTargetFramework=net10.0</Arg>
        <Arg>-p:RuntimeIdentifier=ios-arm64</Arg>
        <Arg>-c</Arg>
        <Arg>Release</Arg>
        <Arg>-p:UseSharedCompilation=false</Arg>
        <Arg>-m:1</Arg>
        <Arg>--disable-build-servers</Arg>
        <Arg>--nologo</Arg>
        <Arg>-v:minimal</Arg>
        <Arg>-p:ArchiveOnBuild=true</Arg>
        <Arg>-p:BuildIpa=true</Arg>
      </Exec>
    </Build>
  </Target>
  <Target id="linux-arm64" platform="linux" framework="net10.0" frameworkProperty="GolemancerTargetFramework">
    <Build>
      <Exec file="dotnet" directory=".">
        <Arg>publish</Arg>
        <Arg>src/Golemancer.Linux/Golemancer.Linux.csproj</Arg>
        <Arg>-r</Arg>
        <Arg>linux-arm64</Arg>
        <Arg>--self-contained</Arg>
        <Arg>true</Arg>
        <Arg>-o</Arg>
        <Arg>Builds/Linux/linux-arm64</Arg>
        <Arg>-p:GolemancerTargetFramework=net10.0</Arg>
        <Arg>-c</Arg>
        <Arg>Release</Arg>
        <Arg>-p:UseSharedCompilation=false</Arg>
        <Arg>-m:1</Arg>
        <Arg>--disable-build-servers</Arg>
        <Arg>--nologo</Arg>
