<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <UseGameRuntime>true</UseGameRuntime>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.golemancer.factory</ApplicationId>
    <ApplicationTitle>The Golemancer's Factory</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidBuildApplicationPackage>true</AndroidBuildApplicationPackage>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- External object-pack DLLs use reflection and JIT. Never trim or statically link them. -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishAot>false</PublishAot>
    <!-- Keep the runtime's normal assembly store/compression. Object-pack DLLs are
         independent AndroidAsset files and are still loaded from disk at runtime. -->
    <AndroidUseAssemblyStore>true</AndroidUseAssemblyStore>
    <AndroidEnableAssemblyCompression>true</AndroidEnableAssemblyCompression>
    <!-- Use dynamic JNI registration for this untrimmed JIT host. The
         SDK's LLVM marshal stubs omitted MainActivity.n_onCreate in Release. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <EnableDefaultAndroidItems>true</EnableDefaultAndroidItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Golemancer.Presentation/Golemancer.Presentation.csproj" />
    <PackageReference Include="SkiaSharp.Views" Version="3.119.4" />
    <AndroidAsset Include="../../Content/Packs/**/*.xml;../../Content/Packs/**/*.png;../../Content/Packs/**/*.svg;../../Content/Packs/**/Bin/net10.0/*.dll;../../Content/Packs/**/Bin/net10.0/*.deps.json">
      <Link>$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)/../../', '%(FullPath)'))</Link>
    </AndroidAsset>
  </ItemGroup>
</Project>
