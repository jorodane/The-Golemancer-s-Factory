<Project DefaultTargets="Publish">
  <PropertyGroup>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))/</RepositoryRoot>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Apk>$(RepositoryRoot)src/Golemancer.Android/bin/$(Configuration)/net10.0-android/com.golemancer.factory-Signed.apk</Apk>
    <Destination>$(RepositoryRoot)Builds/Android/</Destination>
    <SourceRevision Condition="'$(SourceRevision)' == ''">unknown</SourceRevision>
    <EmulatorTested Condition="'$(EmulatorTested)' == ''">false</EmulatorTested>
    <EmulatorApi Condition="'$(EmulatorApi)' == ''">0</EmulatorApi>
  </PropertyGroup>
  <Target Name="Publish">
    <Error Condition="!Exists('$(Apk)')" Text="Build Golemancer.Android first." />
    <MakeDir Directories="$(Destination)" />
    <Copy SourceFiles="$(Apk)" DestinationFiles="$(Destination)Golemancer.apk" />
    <GetFileHash Files="$(Destination)Golemancer.apk" Algorithm="SHA256"><Output TaskParameter="Hash" PropertyName="ApkHash" /></GetFileHash>
    <WriteLinesToFile File="$(Destination)SHA256SUMS" Lines="$(ApkHash)  Golemancer.apk" Overwrite="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(Destination)build-info.json" Lines="{ &quot;sourceCommit&quot;: &quot;$(SourceRevision)&quot;, &quot;framework&quot;: &quot;net10.0-android&quot;, &quot;abis&quot;: [&quot;arm64-v8a&quot;, &quot;x86_64&quot;], &quot;minimumApi&quot;: 26, &quot;developmentSigning&quot;: true, &quot;emulatorTested&quot;: $(EmulatorTested), &quot;emulatorApi&quot;: $(EmulatorApi), &quot;physicalDeviceTested&quot;: false }" Overwrite="true" Encoding="UTF-8" />
  </Target>
</Project>
